# NextAuth
# Generate with: openssl rand -base64 32
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (see docs/SETUP.md section 5.2)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Backend API
# Server-side URL the Next.js app uses to call the FastAPI backend
PYTHON_API_URL=http://127.0.0.1:8000
# Client-side (browser) URL for the backend - baked into the build at build time
NEXT_PUBLIC_PYTHON_API_URL=http://127.0.0.1:8000

# Shared secret with the backend for internal service-to-service calls.
# MUST match INTERNAL_SERVICE_SECRET in api/.env exactly - see docs/SETUP.md section 6.
INTERNAL_SERVICE_SECRET=

# Sentry (optional)
# SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
