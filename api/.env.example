# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/promarshal
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/promarshal
BRAIN_DB_NAME=brain-dev
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=10
MONGODB_MAX_IDLE_TIME_MS=600000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_SOCKET_TIMEOUT_MS=45000

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=True

# Queue Runtime
# Dramatiq is the only supported queue runtime.

# CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Environment
ENVIRONMENT=production

# Security
JWT_SECRET_KEY=change-me
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080
INTERNAL_SERVICE_SECRET=change-me-32-byte-random-secret
INTERNAL_SERVICE_SECRET_PREVIOUS=
INTERNAL_REQUEST_TIMESTAMP_SKEW_SECONDS=60
JWT_ENFORCEMENT_ENABLED=true

# Scheduler / cron trigger auth (see README "Scheduler / Reminders" section)
CRON_SECRET=change-me

# Planner LLM Configuration
PM_CONVERSATION_PROVIDER=anthropic
PM_CONVERSATION_MODEL=claude-sonnet-4-20250514
PM_REASONING_PROVIDER=openai
PM_REASONING_MODEL=gpt-4o

# Cortex Layer A Gateway Provider Migration Flags
# Gateway model provider path is hardwired in runtime.
# Optional toolless shadow compare telemetry (no tool execution in compare path).
CORTEX_GATEWAY_SHADOW_COMPARE_ENABLED=false
# Layer B experimental transport: route tool-calling through shared gateway contract.
CORTEX_USE_GATEWAY_TOOL_CALL_TRANSPORT=false
CORTEX_TASK_READ_FASTPATH_ENABLED=true
CORTEX_FASTPATH_COMPOSE_ENABLED=true

# Jira sprint lookup optimization (negative cache only)
JIRA_NO_ACTIVE_SPRINT_CACHE_TTL_SECONDS=120
# Deprecated: Jira webhooks now use per-project URL token auth.
JIRA_WEBHOOK_SECRET=

# Planner charter read-path cache (Redis-derived, Mongo canonical)
PLANNER_CACHE_ENABLED=true
PLANNER_STATUS_CACHE_TTL_SECONDS=60
PLANNER_ENTITIES_CACHE_TTL_SECONDS=60
PLANNER_CURRENT_STAGE_CACHE_TTL_SECONDS=30
PLANNER_BOOTSTRAP_ASYNC_ENABLED=true
PLANNER_BOOTSTRAP_PAYLOAD_TTL_SECONDS=300
PLANNER_BOOTSTRAP_JOB_STATUS_TTL_SECONDS=1800
PLANNER_BOOTSTRAP_JOB_LOCK_TTL_SECONDS=120

# Scheduler retention and maintenance cleanup defaults
SCHEDULER_DISPATCHER_DAILY_INTERVAL_MINUTES=15
SCHEDULE_RUNS_RETENTION_DAYS=2
CHANNEL_INDEX_RETENTION_DAYS=30
TEAM_POLL_RESULT_RETENTION_DAYS=30
CADENCE_DAILY_SUMMARY_RETENTION_DAYS=90
CLEANUP_SUMMARY_RETENTION_ENABLED=true
CLEANUP_JOB_BATCH_LIMIT=10000

# Action item auto-detect comment classifier (task-comment extraction only)
ACTION_ITEMS_COMMENT_CLASSIFIER_ENABLED=true
ACTION_ITEMS_COMMENT_CLASSIFIER_MIN_CONFIDENCE=0.75

# Transactional email
EMAIL_PROVIDER=zeptomail
ZEPTOMAIL_API_URL=
ZEPTOMAIL_API_KEY=
EMAIL_FROM="ProMarshal <support@promarshal.ai>"
SENDGRID_API_KEY=
