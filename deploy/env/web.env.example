# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=production

# ── NextAuth ──────────────────────────────────────────────────────────────────
NEXTAUTH_URL=https://app.promarshal.ai
AUTH_SECRET=<nextauth-secret>

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=<google-client-id>
GOOGLE_CLIENT_SECRET=<google-client-secret>

# ── Backend API ───────────────────────────────────────────────────────────────
# Server-side (internal Docker network — direct to API container)
PYTHON_API_URL=http://api:8000

# Client-side (browser calls — must be public URL)
# Note: NEXT_PUBLIC_* vars are baked into the bundle at build time.
# Pass NEXT_PUBLIC_PYTHON_API_URL as a build arg in docker-compose.prod.yml.
NEXT_PUBLIC_PYTHON_API_URL=https://api.promarshal.ai

# ── Sentry (optional) ─────────────────────────────────────────────────────────
# SENTRY_DSN=<sentry-dsn>
# SENTRY_AUTH_TOKEN=<sentry-auth-token>
