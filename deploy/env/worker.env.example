# ── Runtime ───────────────────────────────────────────────────────────────────
ENVIRONMENT=production

# ── URLs ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://app.promarshal.ai
BACKEND_URL=https://api.promarshal.ai

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>/promarshal_prod?retryWrites=true&w=majority
BRAIN_DB_NAME=promarshal_brain_prod

# ── Redis/Valkey (local Docker service in docker-compose.prod.yml) ────────────
REDIS_URL=redis://valkey:6379

# ── Security ──────────────────────────────────────────────────────────────────
ENCRYPTION_KEY=<same-as-api>
JWT_SECRET_KEY=<same-as-api>
INTERNAL_SERVICE_SECRET=<same-as-api>
INTERNAL_SERVICE_SECRET_PREVIOUS=<same-as-api>
INTERNAL_REQUEST_TIMESTAMP_SKEW_SECONDS=60

# ── Slack ─────────────────────────────────────────────────────────────────────
SLACK_CLIENT_ID=<same-as-api>
SLACK_CLIENT_SECRET=<same-as-api>
SLACK_SIGNING_SECRET=<same-as-api>

# ── Jira ──────────────────────────────────────────────────────────────────────
JIRA_CLIENT_ID=<same-as-api>
JIRA_CLIENT_SECRET=<same-as-api>
JIRA_WEBHOOK_SECRET=<same-as-api>

# ── LLM APIs ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=<same-as-api>
ANTHROPIC_API_KEY=<same-as-api>
GROQ_API_KEY=<same-as-api>

# ── Worker Config ─────────────────────────────────────────────────────────────
WORKER_QUEUES=cortex_runs chat_interactions workitem_events chat_commands action_item_extraction cadence_dm
DRAMATIQ_WORKER_PROCESSES=1
DRAMATIQ_WORKER_THREADS=2

# ── Neo4j (optional — enables db_listener in start_worker.sh) ────────────────
# NEO4J_URI=neo4j+s://<host>
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=<password>
