# ── Runtime ──────────────────────────────────────────────────────────────────
ENVIRONMENT=production
PORT=8000

# ── URLs ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://app.promarshal.ai
BACKEND_URL=https://api.promarshal.ai
ALLOWED_ORIGINS=https://app.promarshal.ai

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>/promarshal_prod?retryWrites=true&w=majority
BRAIN_DB_NAME=promarshal_brain_prod
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=10

# ── Redis/Valkey (local Docker service in docker-compose.prod.yml) ───────────
REDIS_URL=redis://valkey:6379

# ── Security ──────────────────────────────────────────────────────────────────
ENCRYPTION_KEY=<32-byte-encryption-key>
JWT_SECRET_KEY=<jwt-secret>
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080
CRON_SECRET=<cron-secret>
INTERNAL_SERVICE_SECRET=<internal-secret>
INTERNAL_SERVICE_SECRET_PREVIOUS=<previous-internal-secret>
INTERNAL_REQUEST_TIMESTAMP_SKEW_SECONDS=60

# ── Slack OAuth ───────────────────────────────────────────────────────────────
SLACK_CLIENT_ID=<slack-client-id>
SLACK_CLIENT_SECRET=<slack-client-secret>
SLACK_SIGNING_SECRET=<slack-signing-secret>

# ── Jira OAuth ────────────────────────────────────────────────────────────────
JIRA_CLIENT_ID=<jira-client-id>
JIRA_CLIENT_SECRET=<jira-client-secret>
JIRA_WEBHOOK_SECRET=<jira-webhook-secret>

# ── LLM APIs ─────────────────────────────────────────────────────────────────
OPENAI_API_KEY=<openai-api-key>
ANTHROPIC_API_KEY=<anthropic-api-key>
GROQ_API_KEY=<groq-api-key>
SERPER_API_KEY=<serper-api-key>

# ── LLM Model Config ──────────────────────────────────────────────────────────
PM_CONVERSATION_PROVIDER=anthropic
PM_CONVERSATION_MODEL=claude-sonnet-4-20250514
PM_REASONING_PROVIDER=openai
PM_REASONING_MODEL=gpt-4o

# ── Email (AWS SES via IAM role — no API key needed) ─────────────────────────
EMAIL_FROM=ProMarshal <noreply@promarshal.ai>
SES_REGION=ap-south-1

# ── Scheduler ────────────────────────────────────────────────────────────────
SCHEDULER_USE_DISPATCHER=true
ACTION_ITEMS_ENABLED=true
TEAM_POLL_ENABLED=true

# ── Neo4j (optional) ─────────────────────────────────────────────────────────
# NEO4J_URI=neo4j+s://<host>
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=<password>
